# Configuración del servidor (Reels Studio)
PORT=3001

# Proveedor de IA compatible con OpenAI (ej. OpenRouter, OpenAI, Groq, Ollama)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# API de Pexels para búsqueda automática de fondos en video y fotos
PEXELS_API_KEY=
