{
  "name": "reels-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Generador de reels de frases para Instagram con IA",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "download:fonts": "node scripts/download-fonts.mjs",
    "setup": "npm install && npm run download:fonts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
